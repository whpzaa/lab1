{
  "name": "hdu-is-lab1-secure-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Secure REST API for HDU IS Lab 1 with JWT authentication, SQLi/XSS protection, and CI security scanning.",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
